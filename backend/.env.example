# ── Telegram ──
# From @BotFather. NEVER commit the real token (this file is a template).
BOT_TOKEN=123456:ABC-your-bot-token
# Your deployed HTTPS Mini App URL (Telegram requires HTTPS).
FRONTEND_URL=https://your-app.vercel.app
BOT_USERNAME=AcEarn_bot

# ── Database (Supabase Postgres) / Cache ──
# Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543).
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-DATABASE-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# SSL auto-enables for Supabase URLs; set false for a local Docker Postgres.
# DATABASE_SSL=false
REDIS_URL=redis://localhost:6379

# ── AdsGram ──
# Rewarded block used by the large WATCH AD button. Existing ADSGRAM_BLOCK_ID is kept as a fallback.
ADSGRAM_REWARD_BLOCK_ID=41051
# Interstitial block shown during natural app transitions; format is int-xxx.
ADSGRAM_INTERSTITIAL_BLOCK_ID=int-41047
# Task block rendered below the watch button; format is task-xxx.
ADSGRAM_TASK_BLOCK_ID=task-41052
# Coins credited when <adsgram-task> emits reward.
ADSGRAM_TASK_REWARD=10
# Secret included in AdsGram Reward URL callback.
ADSGRAM_REWARD_SECRET=change-me-long-random-adsgram-reward-secret

# ── Economy (rewards in coins; COINS_PER_USD coins = $1) ──
REWARD_PER_AD=10
AD_COOLDOWN_SECONDS=45
MAX_ADS_PER_DAY=40
REFERRAL_BONUS_PCT=10
REFERRAL_DAILY_CAP=500
MIN_WITHDRAWAL=1000
COINS_PER_USD=1000
# Game features
CHECKIN_REWARD=25
CHECKIN_STREAK_STEP=5
MISSION_JOIN_TELEGRAM_REWARD=100
MISSION_WATCH10_REWARD=150
MISSION_INVITE3_REWARD=300
SPIN_COOLDOWN_SECONDS=86400

# ── Admin ──
# Optional legacy Telegram admin id(s), comma-separated. The web admin uses email/password below.
ADMIN_TELEGRAM_IDS=
ADMIN_SECRET=change-me-admin-secret
# Hidden /admin web login. Prefer ADMIN_PASSWORD_HASH, not plain ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
# Format: scrypt$<salt_hex>$<hash_hex>. Generate with:
# npm run admin:hash-password -- 'YOUR_PASSWORD'
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=change-me-long-random-admin-session-secret
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# ── Server ──
PORT=8787
NODE_ENV=development
